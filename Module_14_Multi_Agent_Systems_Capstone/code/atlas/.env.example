# =============================================================================
# Atlas environment configuration
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# -- Anthropic ----------------------------------------------------------------
# Pay-per-token API key, NOT a Max/Pro session token.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Model strings, locked per tech-stack doc.
ATLAS_MODEL_CEO=claude-opus-5-5
ATLAS_MODEL_SPECIALIST=claude-sonnet-5-5
ATLAS_MODEL_SCAN=claude-haiku-5-5
# Reasoning depth per tier: low, medium, high, xhigh, max
ATLAS_EFFORT_CEO=high
ATLAS_EFFORT_SPECIALIST=medium
# Live chat with the CEO (scheduled briefs keep ATLAS_EFFORT_CEO).
ATLAS_EFFORT_CHAT=medium
# Triage, vetting and summaries on the scan model.
ATLAS_EFFORT_SCAN=low
# Re-run a policy decline on Anthropic's recommended substitute (server side)
ATLAS_REFUSAL_FALLBACKS=true
# Anthropic-hosted web search and fetch for news_discovery, opportunity_scout, the CEO
ATLAS_WEB_TOOLS=true
ATLAS_WEB_SEARCH_MAX_USES=5
# Remote MCP servers Claude calls directly (read-only tools only; runs on Anthropic's side)
# ATLAS_MCP_SERVERS=[{"name":"notion","url":"https://mcp.notion.com/mcp","token":"...","agents":["ceo"],"allowed_tools":["search"]}]

# -- Postgres -----------------------------------------------------------------
# Required by Docker Compose. Use a long random value in every environment.
# The base compose file does not publish Postgres; the dev override publishes
# it on loopback only for native Windows services and local CLI tools.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# -- Ollama (local embeddings) ------------------------------------------------
# The dev override publishes Ollama on loopback only. Production keeps it on
# the internal compose network and app containers use http://ollama:11434.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_PORT=11435
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768

# -- Notifications (R1) -------------------------------------------------------
# Web push to the installed Atlas PWA. Generate a key pair once with
#   python -m scripts.vapid_keys
# and paste both values. The public key is what the browser receives as
# applicationServerKey; the private key signs every push. Blank disables push.
ATLAS_VAPID_PUBLIC_KEY=
ATLAS_VAPID_PRIVATE_KEY=
ATLAS_VAPID_SUBJECT=mailto:you@example.com

# Email fallback: used when no push lands, for high-priority items, and for
# anything still unread an hour later. Gmail works with an app password on
# smtp.gmail.com:587. Blank host disables email entirely.
ATLAS_SMTP_HOST=
ATLAS_SMTP_PORT=587
ATLAS_SMTP_USER=
ATLAS_SMTP_PASSWORD=
ATLAS_SMTP_FROM=
ATLAS_SMTP_STARTTLS=true
ATLAS_NOTIFY_EMAIL=

# -- Atlas runtime ------------------------------------------------------------
ATLAS_ENV=local                       # local | vps
ATLAS_LOG_LEVEL=INFO
ATLAS_TIMEZONE=America/Chicago        # Rosenberg, TX

# Executive loop cadence
ATLAS_LOOP_INTERVAL_MIN=30            # daytime scan interval
ATLAS_LOOP_STAGE_TIMEOUT_MIN=10       # each half of a tick is cut off after this
ATLAS_WEB_WATCHDOG=true               # the web process pages you when the loop stalls
ATLAS_WORKER_WATCHES_WEB=true         # the worker restarts AtlasWeb after 3 missed health checks
ATLAS_WEB_URL=http://127.0.0.1:8000   # where the worker finds the web app
ATLAS_BRIEF_MORNING=08:00
ATLAS_BRIEF_EVENING=20:00
# true: a brief with nothing new since the last one is a short template, no model call
ATLAS_BRIEF_SKIP_UNCHANGED=true

# Approval window before a pending action expires, and how long a running
# agent waits on the card before carrying on (the card stays open).
ATLAS_APPROVAL_TTL_HOURS=24
ATLAS_APPROVAL_WAIT_MIN=10

# Cost guardrails. Atlas refuses new agent runs when daily spend exceeds this.
ATLAS_DAILY_USD_CAP=8.00
ATLAS_KB_USD_CAP=10.00                # one claude.ai export import pauses at this spend (core/kb.py)
ATLAS_RESUME_RUN_USD_CAP=0.40         # one resume-engine run stops before it could pass this
ATLAS_RESUME_DAILY_USD_CAP=1.00       # all resume-engine runs in a UTC day, inside the daily cap
# Safe-start (docs/privacy.md): no model reads mail, calendar or GitHub content until
# this AND mail_model_reads in data/model_exclude.yaml are both true.
ATLAS_MAIL_MODEL_READS=false

# Paths (relative to repo root)
ATLAS_PROCEDURES_DIR=procedures
ATLAS_RUNTIME_PROCEDURES_DIR=data/procedures
ATLAS_LOG_DIR=logs

# -- Senses (R2) --------------------------------------------------------------
# GitHub: a fine-grained personal access token with read-only Contents,
# Issues and Pull requests on the client repos. Repos listed here are
# polled in addition to every active project's repos column. Blank token
# disables the connector.
ATLAS_GITHUB_TOKEN=
ATLAS_GITHUB_REPOS=                    # e.g. atlas-dev/demo-implant-portal,atlas-dev/atlas

# Canvas (HCC Eagle Online): Account -> Settings -> New Access Token.
# Blank token disables the connector.
ATLAS_CANVAS_URL=https://hccs.instructure.com
ATLAS_CANVAS_TOKEN=

# Google (Gmail + Calendar connectors). Create a Desktop-app OAuth client in
# Google Cloud (Gmail API and Calendar API enabled, yourself as a test user),
# put its id and secret here, then run `python -m scripts.google_auth` once
# and paste the refresh token it prints. Testing-mode tokens expire every
# 7 days until the app is published; Atlas pushes a reminder when that happens.
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
ATLAS_GOOGLE_REFRESH_TOKEN=
ATLAS_GOOGLE_CALENDAR_ID=primary

# Pushes outside the two briefs per day. Silence is the default; this is the ceiling.
ATLAS_INTERRUPT_BUDGET=2

# The night shift: propose at 22:30, run at 23:30, report at 07:30 (local
# time), at most this much API spend a night.
ATLAS_NIGHT_PROPOSE_HOUR=22
ATLAS_NIGHT_PROPOSE_MINUTE=30
ATLAS_NIGHT_RUN_HOUR=23
ATLAS_NIGHT_RUN_MINUTE=30
ATLAS_NIGHT_REPORT_HOUR=7
ATLAS_NIGHT_REPORT_MINUTE=30
ATLAS_NIGHT_USD_CAP=2.00
# Signals per Haiku triage call.
ATLAS_TRIAGE_BATCH=20

# -- Heartbeat (optional) -----------------------------------------------------
# Dead-man's switch. Create a free check at https://healthchecks.io, paste its
# ping URL here, and set its period to match ATLAS_LOOP_INTERVAL_MIN. The
# executive loop pings it every tick; if the laptop sleeps or the worker dies,
# healthchecks.io alerts you through a path that does not depend on Atlas.
ATLAS_HEARTBEAT_URL=                  # scripts\connect.bat sets this up (healthchecks.io, free)

# Writes under /api/ need the dashboard's X-Atlas-Client header and a same-host
# Origin (core/web/guard.py). false only as an escape hatch. Add hosts here if
# the dashboard is served under a name the request's Host does not carry.
ATLAS_WRITE_GUARD=true
ATLAS_ALLOWED_ORIGINS=

# -- Calendar (optional) ------------------------------------------------------
# Google Calendar private ICS URL ("secret address in iCal format").
# Found at: Google Calendar -> Settings -> your calendar -> Integrate calendar.
# Atlas reads it read-only over HTTPS; never embed in source.
ATLAS_CALENDAR_ICS_URL=

# -- Offsite backup (optional) ------------------------------------------------
# Atlas writes a daily pg_dump to backups/ locally. Set ATLAS_OFFSITE_BACKEND
# to "rclone" to also push the backup directory to a remote each night.
# Install rclone (https://rclone.org), run `rclone config` to add a remote,
# then point Atlas at it via ATLAS_OFFSITE_REMOTE. Works with Backblaze B2,
# AWS S3, Cloudflare R2, Google Drive, OneDrive, Dropbox, SFTP, WebDAV, etc.
ATLAS_OFFSITE_BACKEND=none            # none | rclone
ATLAS_OFFSITE_REMOTE=                  # e.g. b2:atlas-backups/db
ATLAS_OFFSITE_RETENTION_DAYS=30        # 0 disables remote pruning
ATLAS_OFFSITE_RCLONE_PATH=rclone       # override if rclone is not on PATH
# Runs a trial skill (an adopted learning) must be used in before the Sunday review judges it
ATLAS_SKILL_TRIAL_RUNS=10
